[Unit]
Description=Kemo Plugin Market (static index service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kemomarket
Group=kemomarket
WorkingDirectory=/opt/kemo-market
Environment=MARKET_ROOT=/srv/kemo-plugin-market
ExecStart=/usr/bin/python3 -m kemo_plugin_market serve \
    --root /srv/kemo-plugin-market \
    --bind 127.0.0.1 \
    --port 8099 \
    --quiet
Restart=always
RestartSec=3

# 只读静态服务：收窄到最小权限面
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/kemo-plugin-market
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
